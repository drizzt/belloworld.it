{#- Overrides Zola's built-in Atom template. Today the only feed on this site is the
    one for the /belli/ section, which is Italian, so the feed is Italian too.
    The entry summary is the page description, never the generated summary. -#}
{%- if section -%}
  {%- set feed_title = section.title -%}
  {%- set feed_description = section.description -%}
  {%- set feed_home = section.permalink -%}
{%- else -%}
  {%- set feed_title = config.title -%}
  {%- set feed_description = config.description -%}
  {%- set feed_home = config.base_url -%}
{%- endif -%}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="it">
  <title>{{ feed_title }}</title>
  {%- if feed_description %}
  <subtitle>{{ feed_description }}</subtitle>
  {%- endif %}
  <link rel="self" type="application/atom+xml" href="{{ feed_url | safe }}"/>
  <link rel="alternate" type="text/html" href="{{ feed_home | safe }}"/>
  <id>{{ feed_url | safe }}</id>
  {#- last_updated is missing when the section has no dated pages yet. -#}
  <updated>{{ last_updated | default(value=now()) | date(format="%+") }}</updated>
  <author>
    <name>{{ config.extra.username }}</name>
  </author>
  {%- for page in pages %}
  <entry xml:lang="it">
    <title>{{ page.title }}</title>
    <link rel="alternate" type="text/html" href="{{ page.permalink | safe }}"/>
    <id>{{ page.permalink | safe }}</id>
    <published>{{ page.date | date(format="%+") }}</published>
    <updated>{{ page.updated | default(value=page.date) | date(format="%+") }}</updated>
    {%- if page.description %}
    <summary>{{ page.description }}</summary>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>
